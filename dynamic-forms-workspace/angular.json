{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "@schematics/angular"
    ]
  },
  "projects": {
    "dynamic-forms": {
      "projectType": "library",
      "root": "projects/dynamic-forms",
      "sourceRoot": "projects/dynamic-forms/src",
      "prefix": "df",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true,
          "flat": false
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/dynamic-forms/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/dynamic-forms/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/dynamic-forms/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/dynamic-forms/tsconfig.spec.json",
            "coverageInclude": [
              "projects/dynamic-forms/src/lib/**/*.ts"
            ],
            "coverageExclude": [
              "projects/dynamic-forms/src/lib/testing/**"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/dynamic-forms/**/*.ts",
              "projects/dynamic-forms/**/*.html"
            ],
            "eslintConfig": "projects/dynamic-forms/eslint.config.js"
          }
        }
      }
    },
    "demo-showcase": {
      "projectType": "application",
      "root": "projects/demo-showcase",
      "sourceRoot": "projects/demo-showcase/src",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true,
          "flat": false
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/demo-showcase",
            "index": "projects/demo-showcase/src/index.html",
            "browser": "projects/demo-showcase/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/demo-showcase/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/demo-showcase/public"
              }
            ],
            "styles": [
              "projects/demo-showcase/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/dynamic-forms/src/styles"
              ]
            },
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kb",
                  "maximumError": "16kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "demo-showcase:build:production"
            },
            "development": {
              "buildTarget": "demo-showcase:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/demo-showcase/**/*.ts",
              "projects/demo-showcase/**/*.html"
            ],
            "eslintConfig": "projects/demo-showcase/eslint.config.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
